<script>
(function () {
  var s = document.querySelector('#lxm [data-sticky]'), h = document.querySelector('#lxm .hero-sec'), e = document.getElementById('lxm-end');
  if (!s || !('IntersectionObserver' in window)) return;
  var a = false, b = false, u = function () { s.classList.toggle('on', a && !b); };
  new IntersectionObserver(function (x) { a = !x[0].isIntersecting; u(); }).observe(h);
  new IntersectionObserver(function (x) { b = x[0].isIntersecting; u(); }).observe(e);
})();
</script>

